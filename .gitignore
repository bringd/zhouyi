# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Server build output
server/dist/
server/.pg-data/
server/scripts/.pg-data-cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.dev.vars

# Testing
coverage/
*.lcov
.nyc_output/

# Vite cache
.vite/
.cache/

# TypeScript composite project output
node_modules/.tmp/
*.tsbuildinfo

# Claude / Claude Code
.claude/
.superpowers/brainstorm/*/content/
.superpowers/brainstorm/*/state/
# Keep brainstorm metadata for reference
!.superpowers/brainstorm/.gitkeep
!.superpowers/docs/

# Temp
tmp/
temp/

# Cloudflare wrangler local D1 + Workers state (do not commit)
.wrangler/

# External tool output (opc-doc is a runtime artifact, not source)
opc-doc/

# Visual test artifacts: 100+ PNGs produced by scripts/shot-*.mjs and
# scripts/check-*.mjs. They are regeneratable from the committed scripts;
# the curated HTML mockups live under docs/mockups/ instead.
screenshots/

# .opencode/ is a per-machine agent installation. Only its agents/*.md
# definitions are tracked (used by docs/opencode-token-plan-setup.md).
.opencode/node_modules/
.opencode/bun.lock
.opencode/package-lock.json

# Per-machine npm config: registry mirrors (e.g. npmmirror.com in CN),
# package manager toggles, etc. Project-level policy belongs in
# package.json's `packageManager` field instead.
.npmrc
