# Cloudflare Pages / Workers config (orix-studio frontend).
# See docs/deploy/cloudflare-pages.md for full setup steps.

name = "orix-studio"
compatibility_date = "2025-04-01"
pages_build_output_dir = "./dist"

# Build command: `npm run build` (Vite). Output dir: `dist`.
# Configure in Cloudflare dashboard under:
#   Pages → orix-studio → Settings → Builds
#     Build command:        npm run build
#     Build output:         dist
#     Root directory:        /
#     Build system version: 4 (latest)
#     Node version:          20

# Environment variables exposed to the build (PUBLIC_* are inlined at build
# time by Vite). Add a custom domain in dashboard under "Custom domains".
[vars]
# Leave empty in repo — set in dashboard per environment.
# Example:
# NODE_VERSION = "20"
# PUBLIC_API_BASE = "https://orix-studio.fly.dev"

# D1 binding shared with worker/zhouyi-worker for AI demo quota tracking.
# When using `wrangler pages deploy`, this binding is picked up
# automatically. When using the Cloudflare GitHub App auto-deploy,
# the binding must also be added manually in the dashboard under:
#   Pages → orix-studio → Settings → Functions → D1 database bindings
#     Variable name: DB
#     D1 database:  zhouyi-db
[[d1_databases]]
binding = "DB"
database_name = "zhouyi-db"
database_id = "c4cdb8e8-a4f6-4c65-be35-afa4b3ade0a2"
