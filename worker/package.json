{
  "name": "@zhouyi/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply zhouyi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zhouyi-db --remote",
    "db:studio:local": "wrangler d1 studio zhouyi-db --local"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.68",
    "@cloudflare/workers-types": "^4.20241112.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4",
    "wrangler": "^3.91.0"
  }
}
