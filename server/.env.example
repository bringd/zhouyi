NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:4180,http://localhost:4181

# Database (Task B2)
# Local dev (Docker):  docker run -d --name zhouyi-pg -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=zhouyi -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zhouyi

# Auth (Task B3)
JWT_SECRET=replace-with-a-32-char-random-string-please

# AI (Task B4)
# Required for /api/ai/interpret to work.
#
# Two ways to provide the key (ANTHROPIC_AUTH_TOKEN takes precedence):
#   ANTHROPIC_API_KEY=sk-ant-...           # direct Anthropic API
#   ANTHROPIC_AUTH_TOKEN=sk-cp-...         # MiniMax-style token
#
# `baseURL` is the Anthropic-Messages-API-compatible endpoint. Leave unset
# to use the default Anthropic endpoint.
#   ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
#
# `ANTHROPIC_MODEL` is the model ID passed to the endpoint. Default below
# targets MiniMax. For direct Anthropic, set to e.g. claude-haiku-4-5.
ANTHROPIC_MODEL=MiniMax-M3

# Optional: override the default IP rate limit (5/day)
# AI_DAILY_LIMIT=5

# Optional: absolute path to hexagrams.json (defaults to repo-root src/data/hexagrams.json)
# HEXAGRAMS_JSON_PATH=/path/to/hexagrams.json

# Session cookie (Task B5)
# The defaults are fine for development. In production behind HTTPS the
# deployment proxy should ensure the cookie carries the Secure flag.
# SESSION_COOKIE_NAME=zhouyi_session
# SESSION_COOKIE_MAX_AGE_DAYS=365
