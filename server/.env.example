NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Database (Task B2)
# Local dev:  embedded-postgres via `npm run dev:pg` (auto-bootstraps)
# Or system PG:  docker run -d --name zhouyi-pg -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=zhouyi -p 5432:5432 postgres:16
# Production:  `fly postgres create` then `fly postgres attach zhouyi-db`
#              (Fly auto-injects DATABASE_URL as a secret)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zhouyi

# Auth (Task B3)
# Generate:  openssl rand -hex 32
JWT_SECRET=replace-with-a-32-char-random-string-please

# AI (Task B4)
# Required for /api/ai/interpret to work.
# Get one at https://console.anthropic.com
# In production, set via `fly secrets set ANTHROPIC_API_KEY=...`
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default IP rate limit (5/day)
# AI_DAILY_LIMIT=5

# Optional: absolute path to hexagrams.json (defaults to repo-root src/data/hexagrams.json)
# HEXAGRAMS_JSON_PATH=/path/to/hexagrams.json

# Session cookie (Task B5)
# In production behind HTTPS, Fly's load balancer sets Secure flag automatically.
# SESSION_COOKIE_NAME=zhouyi_session
# SESSION_COOKIE_MAX_AGE_DAYS=365

# === Production-only (Fly.io / Cloudflare in front) ===
# In production NODE_ENV=production and the Express server serves the
# Vite-built dist/ directory. FRONTEND_ORIGIN must be the public origin
# the browser sends Origin: header from (no trailing slash).
#
# Custom domain example:
#   FRONTEND_ORIGIN=https://zhouyi.example.com
# Default Fly subdomain:
#   FRONTEND_ORIGIN=https://zhouyi.fly.dev
#
# Behind Cloudflare: use the Cloudflare-proxied origin.
#   FRONTEND_ORIGIN=https://zhouyi.example.com

